# gocryptfs-web systemd 系统级单元模板（推荐：与 rbackup-web 同一套骨架）
#
# 用法：
#   sed -e 's|__USER__|admin|g' -e 's|__GROUP__|users|g' -e 's|__HOME__|/home/admin|g' \
#       contrib/systemd/gocryptfs-web.service | sudo tee /etc/systemd/system/gocryptfs-web.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now gocryptfs-web
#
# 说明：
#   - 必须以「拥有这些加密卷的普通用户」运行（不要用 root）；
#   - 只监听 loopback，对外入口交给 Nginx/Caddy（见 contrib/nginx/ 与 docs/deploy.md）；
#   - 反代场景必须加 --trust-proxy；不要固定 --public-url，这样域名与
#     IP:端口两个入口都能生成正确的扫码链接与 Secure cookie；
#   - gocryptfs 的挂载/卸载必须在 host mount namespace 中完成，因此本单元
#     刻意不使用创建私有 mount namespace 的选项（PrivateTmp/ProtectSystem/
#     ProtectHome/ProtectKernelTunables/ProtectControlGroups），也不能开
#     NoNewPrivileges/RestrictSUIDSGID（会禁用 fusermount 的 setuid）；
#   - 若之前用过用户级单元，请先 systemctl --user disable --now gocryptfs-web
#     并删除，避免两个进程抢同一端口。

[Unit]
Description=gocryptfs-web — browser UI for gocryptfs vaults
Documentation=https://github.com/lockejet/gocryptfs-ui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=HOME=__HOME__
WorkingDirectory=__HOME__
ExecStart=__HOME__/.local/bin/gocryptfs-web --listen 127.0.0.1:30032 --trust-proxy
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

# 重要：挂载/卸载需要在 host mount namespace 中完成，不要加这些选项：
NoNewPrivileges=no
PrivateTmp=no
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=multi-user.target
